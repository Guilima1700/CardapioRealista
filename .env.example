# sqlite: demonstração local persistente. supabase: instalação real.
DATA_BACKEND=sqlite
NEXT_PUBLIC_DATA_BACKEND=sqlite
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Obrigatório em produção: segredo aleatório de pelo menos 32 caracteres.
SESSION_SECRET=
# Acesso local de desenvolvimento: admin@brasa.local / Demo@2026!
DEMO_ADMIN_EMAIL=admin@brasa.local
DEMO_ADMIN_PASSWORD=Demo@2026!
# Preencher todos para DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
